{
  "manifest_version": 3,
  "name": "Ungrift",
  "version": "0.9.1",
  "minimum_chrome_version": "116",
  "description": "Classifies X and LinkedIn posts and adds visual privacy for recordings.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://api.typesafe.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Ungrift settings",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/tweet-data.js", "src/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["src/classification.js", "src/linkedin-data.js", "src/content.js", "src/privacy.js"],
      "run_at": "document_start"
    }
  ]
}
